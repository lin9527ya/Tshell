{
  "name": "tshell-web",
  "version": "1.0.0",
  "private": true,
  "web-types": "./web-types.json",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:with-check": "run-p type-check build-only",
    "build-only": "vite build",
    "build:prod": "vite build --mode production",
    "build:analyze": "vite build --mode production && npx vite-bundle-analyzer dist",
    "preview": "vite preview",
    "test:unit": "vitest",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint src --ext .vue,.js,.ts",
    "lint:fix": "eslint src --ext .vue,.js,.ts --fix",
    "format": "prettier --write src/",
    "build:embed": "npm run build && node scripts/copy-to-backend.js",
    "deploy:full": "npm run build:embed && cd ../Tshell---A-Cross-Platform-C2 && go build -o tshell-server ."
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.1.0",
    "@unocss/preset-mini": "^66.4.2",
    "axios": "^1.5.0",
    "axios-retry": "^4.0.0",
    "element-plus": "^2.3.12",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-typescript": "^3.0.0",
    "eslint-plugin-cypress": "^2.15.1",
    "pinia": "^2.1.6",
    "pinia-plugin-persistedstate": "^3.2.0",
    "vue": "^3.3.4",
    "vue-clipboard3": "^2.0.0",
    "vue-router": "^4.2.4",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-unicode11": "^0.6.0",
    "xterm-addon-web-links": "^0.9.0",
    "xterm-addon-webgl": "^0.16.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.3.2",
    "@tsconfig/node18": "^18.2.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^18.18.4",
    "@unocss/eslint-config": "^0.59.4",
    "@unocss/reset": "^0.62.4",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^4.1.0",
    "@vue/cli-plugin-typescript": "^4.5.17",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^11.0.3",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.4.0",
    "eslint-plugin-vue": "^9.23.0",
    "jsdom": "^24.1.3",
    "less": "^4.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "3.0.3",
    "sass": "^1.92.1",
    "typescript": "~5.5.0",
    "unocss": "^0.62.4",
    "unplugin-auto-import": "^0.17.8",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^5.4.21",
    "vitest": "^1.6.1",
    "vue-tsc": "^2.0.29"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "vue-demi@0.14.6": true,
    "ejs@2.7.4": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "vue-demi@0.14.10": true,
    "yorkie@2.0.0": true
  }
}
